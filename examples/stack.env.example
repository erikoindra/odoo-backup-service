# Variables for examples/portainer-stack.yml.
# Portainer > Stack > Environment variables > "Load variables from .env file",
# or type them in one by one. Never commit a file with the real password.

# --- required ---
IMAGE=ghcr.io/OWNER/odoo-docker-backup:pg17
PGHOST=odoo-db
PGUSER=odoo
PGPASSWORD=change-me
ODOO_DATA_VOLUME=myproject_odoo_data_dir
DB_NETWORK=myproject_default

# --- optional (defaults shown) ---
PGPORT=5432
# empty = auto-detect every database that has a filestore folder
DB_NAME=
BACKUP_PREFIX=
BACKUP_VOLUME=odoo-backups
RETENTION_DAYS=3
CRON_SCHEDULE=0 2 * * *
TZ=UTC
RUN_ON_START=false
MIN_FREE_MB=1024
