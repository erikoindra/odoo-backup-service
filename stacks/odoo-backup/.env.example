# Variables for stacks/odoo-backup/docker-compose.yml.
# Portainer > Stack > Environment variables > "Load variables from .env file",
# or type them in one by one. tools/discover.sh prints most of them for you.
# Never commit a file with the real password.

# --- required ---
PGHOST=odoo-db
PGUSER=odoo
PGPASSWORD=change-me
ODOO_DATA_VOLUME=myproject_odoo_data_dir
DB_NETWORK=myproject_default

# --- optional (defaults shown) ---
# pick the tag that matches your PostgreSQL server major: pg14 ... pg18
IMAGE=ghcr.io/erikoindra/odoo-backup-service:pg17
PGPORT=5432
# empty = auto-detect every database that has a filestore folder
DB_NAME=
BACKUP_PREFIX=
BACKUP_VOLUME=odoo-backups
RETENTION_DAYS=3
CRON_SCHEDULE=0 2 * * *
TZ=UTC
RUN_ON_START=false
MIN_FREE_MB=1024
# only if Odoo's data_dir is not the root of ODOO_DATA_VOLUME
FILESTORE_ROOT=/odoo-data/filestore
